# Copy to .env for local runs (`node --env-file=.env server/index.js`).
# On Railway, set these under the service's Variables tab instead.

# --- Claude course recommender ---------------------------------------
# Required for AI recommendations. Without it the kiosk uses offline rules.
ANTHROPIC_API_KEY=
# Model and effort for the recommender (defaults shown).
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=low
# Per-request timeout before falling back to offline rules (ms).
AI_TIMEOUT_MS=20000
# Server-side refusal fallback: "default" or "off".
AI_FALLBACKS=default
# Kill switch without removing the key: true | false
AI_ENABLED=true
# Spend guard: max Claude calls per hour (cache hits are free).
AI_MAX_CALLS_PER_HOUR=500
AI_CACHE_TTL_MINUTES=360
AI_CACHE_MAX_ENTRIES=1000
AI_MAX_TOKENS=8000

# --- Fekra innovation assistant (uses ANTHROPIC_API_KEY) ---------------
FEKRA_ENABLED=true
# FEKRA_MODEL defaults to ANTHROPIC_MODEL.
# FEKRA_MODEL=claude-opus-5-5
FEKRA_CHAT_EFFORT=low
FEKRA_UPDATE_EFFORT=low
FEKRA_EFFORT=medium
# Live web research for the innovation check (also needs web search allowed in the Claude Console).
FEKRA_WEB_SEARCH=true
FEKRA_MAX_SEARCHES=6
FEKRA_TIMEOUT_MS=150000
FEKRA_MAX_CALLS_PER_HOUR=300
FEKRA_IDLE_RESET_SECONDS=600
# Saved proposals: a persistent folder (on Railway, a mounted volume such as /data/fekra). Unset = temporary.
FEKRA_STORE_DIR=
# Behind GDRFA single sign-on: the header carrying the signed-in user (proposals then belong to that user).
# FEKRA_IDENTITY_HEADER=x-ms-client-principal-name
# Management review endpoint for "Submit for Management Review". Empty = not connected (nothing is sent).
FEKRA_SUBMIT_URL=
# Secret bearer token for that endpoint, if it needs one. Keep it out of git.
FEKRA_SUBMIT_TOKEN=

# --- Live news ticker (sources: server/news-sources.js) ---------------
NEWS_ENABLED=true
NEWS_REFRESH_MINUTES=30
NEWS_MAX_ITEMS=30
NEWS_TIMEOUT_MS=12000
NEWS_VERIFY_LINKS=true
# NEWS_CACHE_FILE=/data/news-cache.json   (a persistent volume keeps the cache across deploys)
# NEWS_SOURCES_FILE=/path/to/sources.json

# --- Kiosk ------------------------------------------------------------
# relative = demo schedule built around "now"; fixed = use session times in content.js
SCHEDULE_MODE=relative
EVENT_TIMEZONE=Asia/Dubai
IDLE_WARN_SECONDS=75
IDLE_RESET_SECONDS=90
# Base URL printed in passport QR codes (e.g. your custom domain). Defaults to the page's own URL.
PUBLIC_BASE_URL=

# --- Server -----------------------------------------------------------
# PORT is set automatically by Railway; 3000 locally.
# PORT=3000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info
# Auto-enabled on Railway; set true behind any other reverse proxy.
# TRUST_PROXY=false
