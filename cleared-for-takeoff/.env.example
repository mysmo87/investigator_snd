# Copy to .env for local runs (`node --env-file=.env server/index.js`).
# On Railway, set these under the service's Variables tab instead.

# --- Claude course recommender ---------------------------------------
# Required for AI recommendations. Without it the kiosk uses offline rules.
ANTHROPIC_API_KEY=
# Model and effort for the recommender (defaults shown).
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=low
# Per-request timeout before falling back to offline rules (ms).
AI_TIMEOUT_MS=20000
# Server-side refusal fallback: "default" or "off".
AI_FALLBACKS=default
# Kill switch without removing the key: true | false
AI_ENABLED=true
# Spend guard: max Claude calls per hour (cache hits are free).
AI_MAX_CALLS_PER_HOUR=500
AI_CACHE_TTL_MINUTES=360
AI_CACHE_MAX_ENTRIES=1000
AI_MAX_TOKENS=8000

# --- Kiosk ------------------------------------------------------------
# relative = demo schedule built around "now"; fixed = use session times in content.js
SCHEDULE_MODE=relative
EVENT_TIMEZONE=Asia/Dubai
IDLE_WARN_SECONDS=75
IDLE_RESET_SECONDS=90
# Base URL printed in passport QR codes (e.g. your custom domain). Defaults to the page's own URL.
PUBLIC_BASE_URL=

# --- Server -----------------------------------------------------------
# PORT is set automatically by Railway; 3000 locally.
# PORT=3000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info
# Auto-enabled on Railway; set true behind any other reverse proxy.
# TRUST_PROXY=false
